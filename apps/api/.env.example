SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SPOTME_DATABASE_URL=
PORT=3080
SPOTME_SIGNUP_ENABLED=false
# Leave blank for http://127.0.0.1:PORT. For an HTTPS proxy, set its exact public origin.
# SPOTME_WEB_ORIGIN=https://example.test

# Leave unset to disable Apple checkout. Use Sandbox only with isolated staging data.
# SPOTME_APPLE_ENVIRONMENT=Sandbox
# SPOTME_APPLE_BILLING_DATABASE_URL=
# SPOTME_APPLE_APP_ID=
# SPOTME_APPLE_KEY_ID=
# SPOTME_APPLE_ISSUER_ID=
# SPOTME_APPLE_KEY_FILE=
# SPOTME_APPLE_ROOT_FILES=

# Play and Stripe share the entitlement environment with Apple, if enabled.
# SPOTME_BILLING_ENVIRONMENT=Sandbox
# SPOTME_EXTERNAL_BILLING_DATABASE_URL=
# SPOTME_STRIPE_SECRET_KEY=
# SPOTME_STRIPE_WEBHOOK_SECRET=
# SPOTME_STRIPE_WEEKLY_PRICE=
# SPOTME_STRIPE_MONTHLY_PRICE=
# SPOTME_PLAY_ENABLED=true
# SPOTME_PLAY_ACCOUNT_SECRET=
# SPOTME_PLAY_PUSH_SERVICE_ACCOUNT=
# SPOTME_PLAY_PUSH_AUDIENCE=
# GOOGLE_APPLICATION_CREDENTIALS=
